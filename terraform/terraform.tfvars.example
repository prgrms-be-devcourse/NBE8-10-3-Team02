# 이 파일을 복사해서 terraform.tfvars 로 저장 후 실제 값 입력
# terraform.tfvars 는 .gitignore 에 포함되어 있어 Git에 커밋되지 않음

aws_region   = "ap-northeast-2"
project_name = "nbe-team02"

# ──────────────────────────────────────────
# DB
# ──────────────────────────────────────────
db_name     = "gamedb"
db_username = "your_db_username"
db_password = "your_strong_password"

# ──────────────────────────────────────────
# 애플리케이션
# ──────────────────────────────────────────
jwt_secret_key      = "your_jwt_secret_key"
igdb_client_id      = "your_igdb_client_id"
igdb_client_secret  = "your_igdb_client_secret"
steam_api_key       = "your_steam_api_key"
discord_webhook_url = "https://discord.com/api/webhooks/..."

# ──────────────────────────────────────────
# EC2 / Docker
# ──────────────────────────────────────────
# AWS 콘솔 > EC2 > Key Pairs 에서 미리 생성해야 함
key_pair_name = "your-key-pair-name"

# GHCR 이미지 URL (패키지를 Public으로 설정하거나 별도 인증 필요)
docker_image = "ghcr.io/your-org/your-repo:latest"
